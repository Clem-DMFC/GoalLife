# Copier ce fichier en `.env` et remplir avec les valeurs du projet Supabase
# (Dashboard Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clé PUBLIQUE VAPID, pour les notifications de rappel (base64url, ~87 car.).
# Générée par `npx web-push generate-vapid-keys` — la clé privée, elle, va
# dans les secrets Supabase et ne doit jamais arriver ici.
# Laisser vide désactive proprement les rappels dans les réglages.
VITE_VAPID_PUBLIC_KEY=
